exports[`actas CNI HTML > acta de asignación incluye encabezado CNI y condiciones 1`] = `
"<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>Acta de asignación CNI</title>
  <style>
  @page { size: Letter; margin: 14mm 12mm 18mm 12mm; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: Carlito, Calibri, "Segoe UI", sans-serif; font-size: 11pt; color: #222; line-height: 1.45; }
  .page { position: relative; min-height: 100%; padding-bottom: 28px; }
  header.acta-header { position: relative; margin-bottom: 16px; min-height: 72px; }
  header.acta-header img.logo { position: absolute; top: 0; right: 0; height: 56px; width: auto; }
  header.acta-header .center { text-align: center; padding: 0 80px 0 0; }
  header.acta-header h1 { margin: 0; font-size: 13pt; color: #252A58; font-weight: 700; }
  header.acta-header p.conf { margin: 6px 0 0; font-size: 10pt; font-weight: 600; }
  .doc-date { text-align: right; margin: 8px 0 16px; font-size: 10.5pt; }
  .memo-line { margin: 6px 0; }
  h2.section { color: #252A58; font-size: 12pt; margin: 18px 0 8px; font-weight: 700; }
  table.detail-table { width: 100%; border-collapse: collapse; margin: 8px 0 12px; }
  table.detail-table th, table.detail-table td { border: 1px solid #bbb; padding: 6px 8px; text-align: left; vertical-align: top; }
  table.detail-table th { width: 38%; background: #f7f8fc; font-weight: 600; }
  ol.conditions { margin: 8px 0 16px 20px; padding: 0; }
  ol.conditions li { margin-bottom: 6px; }
  ul.bullets { margin: 8px 0 16px 20px; }
  p { margin: 0 0 10px; }
  .signatures { display: flex; gap: 24px; margin-top: 20px; }
  .signatures .signature { flex: 1; }
  .sig-line { border-bottom: 1px solid #333; height: 28px; margin-bottom: 6px; }
  .sig-label { font-weight: 600; margin: 0 0 4px; }
  .sig-meta { margin: 0 0 2px; font-size: 10pt; color: #444; }
  .note { margin-top: 18px; font-size: 9.5pt; color: #444; border-top: 1px solid #ddd; padding-top: 10px; }
  footer.acta-footer {
    position: fixed; left: 12mm; right: 12mm; bottom: 8mm;
    display: flex; justify-content: space-between; font-size: 8.5pt; color: #5a6a8a;
  }
  h1.discharge-title { text-align: center; color: #252A58; font-size: 14pt; margin: 0; }
  p.discharge-sub { text-align: center; font-style: italic; margin: 6px 0 16px; }
  table.inventory { width: 100%; border-collapse: collapse; margin: 10px 0 14px; font-size: 10pt; }
  table.inventory th { background: #252A58; color: #fff; padding: 6px; border: 1px solid #252A58; }
  table.inventory td { border: 1px solid #bbb; padding: 5px 6px; vertical-align: top; }
  .data-block { margin: 12px 0 16px; }
  .data-block p { margin: 4px 0; }
</style>
</head>
<body>
  <div class="page">
    <header class="acta-header">
      <img class="logo" src="data:image/png;base64," alt="CNI" />
      <div class="center">
        <h1>CONSEJO NACIONAL DE INVERSIONES (CNI)</h1>
        <p class="conf">USO INTERNO — CONFIDENCIAL</p>
      </div>
    </header>
    
    
    <p class="doc-date">Tegucigalpa, M.D.C. — 10 agosto de 2026</p>
    <p class="memo-line"><strong>Para:</strong> Ana Ficticia López — Informática y Tecnología</p>
    <p class="memo-line"><strong>De:</strong> Carlos Ficticio Mejía — Dirección Administrativa</p>
    <p class="memo-line"><strong>Asunto:</strong> Asignación de equipo de cómputo</p>
  
    <p><strong>Por medio del presente se informa que, con fecha indicada arriba, se procede a la entrega y asignación del siguiente equipo de cómputo para uso institucional del CNI.</strong> El equipo permanecerá bajo la custodia y responsabilidad del funcionario receptor y su uso deberá regirse por las políticas internas de seguridad y uso de recursos informáticos del CNI.</p>
    <h2 class="section">Detalles del equipo</h2>
    <table class="detail-table"><tr><th>Marca / Modelo</th><td>Dell / Latitude 5540</td></tr><tr><th>Número de Serie (S/N)</th><td>SN-FICT-001</td></tr><tr><th>Número de Inventario</th><td>CNI-IT-0001</td></tr><tr><th>Memoria RAM</th><td>16 GB</td></tr><tr><th>Procesador</th><td>Intel i7</td></tr><tr><th>Almacenamiento</th><td>512 GB SSD</td></tr><tr><th>Sistema operativo</th><td>Windows 11</td></tr><tr><th>Accesorios incluidos</th><td>Cargador, mouse</td></tr><tr><th>Software instalado</th><td>Microsoft 365, Antivirus institucional</td></tr></table>
    <h2 class="section">Condiciones de Entrega</h2>
    <ol class="conditions"><li value="1">El equipo se entrega nuevo y con el software institucional necesario para el desempeño de las funciones.</li><li value="2">El receptor se compromete a utilizar el equipo exclusivamente para actividades relacionadas con sus funciones en el CNI.</li><li value="3">No instalar software no autorizado ni transferir licencias sin autorización previa por escrito.</li><li value="4">Reportar de inmediato cualquier daño, pérdida o robo a la Dirección Administrativa.</li><li value="5">En caso de terminación de la relación laboral o traslado de funciones, el equipo deberá devolverse en las mismas condiciones en que fue entregado, incluyendo el respaldo (backup) total de la información contenida en la máquina, salvo el desgaste razonable por uso normal.</li></ol>
    <h2 class="section">Aceptación y firma</h2>
    <p>Declaro haber recibido el equipo descrito en este memorándum, así como haber sido informado de las obligaciones y condiciones de uso establecidas por el CNI.</p>
    <div class="signatures">
      <div class="signature">
    <div class="sig-line"></div>
    <p class="sig-label">Firma del receptor</p>
    <p>Ana Ficticia López</p>
    <p class="sig-meta">Cargo: Analista de sistemas – Informática y Tecnología</p>
    <p class="sig-meta"></p>
  </div>
      <div class="signature">
    <div class="sig-line"></div>
    <p class="sig-label">Firma del responsable de entrega</p>
    <p>Carlos Ficticio Mejía</p>
    <p class="sig-meta">Cargo: Jefe de activos - Dirección Administrativa</p>
    <p class="sig-meta"></p>
  </div>
    </div>
    <p>Fecha: 10/08/2026</p>
  
    <p class="note">Nota de confidencialidad: Este documento contiene información interna del CNI sobre activos y licencias. Queda terminantemente prohibida su difusión externa sin autorización expresa de la Dirección correspondiente.</p>
  </div>
  <footer class="acta-footer">
    <span>Centro Cívico Gubernamental, Blvd. Juan Pablo II, / Diag. República de Corea, Tegucigalpa</span>
    <span>Tel. +504 2242-8955 / www.cni.hn</span>
  </footer>
</body>
</html>"
`;

exports[`actas CNI HTML > acta de descargo enmascara licencia DEVICE en filas del formulario 1`] = `
"<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>ACTA DE DESCARGO Y DEVOLUCIÓN DE EQUIPO</title>
  <style>
  @page { size: Letter; margin: 14mm 12mm 18mm 12mm; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: Carlito, Calibri, "Segoe UI", sans-serif; font-size: 11pt; color: #222; line-height: 1.45; }
  .page { position: relative; min-height: 100%; padding-bottom: 28px; }
  header.acta-header { position: relative; margin-bottom: 16px; min-height: 72px; }
  header.acta-header img.logo { position: absolute; top: 0; right: 0; height: 56px; width: auto; }
  header.acta-header .center { text-align: center; padding: 0 80px 0 0; }
  header.acta-header h1 { margin: 0; font-size: 13pt; color: #252A58; font-weight: 700; }
  header.acta-header p.conf { margin: 6px 0 0; font-size: 10pt; font-weight: 600; }
  .doc-date { text-align: right; margin: 8px 0 16px; font-size: 10.5pt; }
  .memo-line { margin: 6px 0; }
  h2.section { color: #252A58; font-size: 12pt; margin: 18px 0 8px; font-weight: 700; }
  table.detail-table { width: 100%; border-collapse: collapse; margin: 8px 0 12px; }
  table.detail-table th, table.detail-table td { border: 1px solid #bbb; padding: 6px 8px; text-align: left; vertical-align: top; }
  table.detail-table th { width: 38%; background: #f7f8fc; font-weight: 600; }
  ol.conditions { margin: 8px 0 16px 20px; padding: 0; }
  ol.conditions li { margin-bottom: 6px; }
  ul.bullets { margin: 8px 0 16px 20px; }
  p { margin: 0 0 10px; }
  .signatures { display: flex; gap: 24px; margin-top: 20px; }
  .signatures .signature { flex: 1; }
  .sig-line { border-bottom: 1px solid #333; height: 28px; margin-bottom: 6px; }
  .sig-label { font-weight: 600; margin: 0 0 4px; }
  .sig-meta { margin: 0 0 2px; font-size: 10pt; color: #444; }
  .note { margin-top: 18px; font-size: 9.5pt; color: #444; border-top: 1px solid #ddd; padding-top: 10px; }
  footer.acta-footer {
    position: fixed; left: 12mm; right: 12mm; bottom: 8mm;
    display: flex; justify-content: space-between; font-size: 8.5pt; color: #5a6a8a;
  }
  h1.discharge-title { text-align: center; color: #252A58; font-size: 14pt; margin: 0; }
  p.discharge-sub { text-align: center; font-style: italic; margin: 6px 0 16px; }
  table.inventory { width: 100%; border-collapse: collapse; margin: 10px 0 14px; font-size: 10pt; }
  table.inventory th { background: #252A58; color: #fff; padding: 6px; border: 1px solid #252A58; }
  table.inventory td { border: 1px solid #bbb; padding: 5px 6px; vertical-align: top; }
  .data-block { margin: 12px 0 16px; }
  .data-block p { margin: 4px 0; }
</style>
</head>
<body>
  <div class="page">
    <header class="acta-header">
      <img class="logo" src="data:image/png;base64," alt="CNI" />
      <div class="center">
        <h1>CONSEJO NACIONAL DE INVERSIONES (CNI)</h1>
        <p class="conf">USO INTERNO — CONFIDENCIAL</p>
      </div>
    </header>
    
    <h1 class="discharge-title">ACTA DE DESCARGO Y DEVOLUCIÓN DE EQUIPO</h1>
    <hr />
    <p class="discharge-sub">Terminación de relación laboral</p>
    <p class="doc-date">Tegucigalpa, M.D.C. — 10 agosto de 2026</p>
    <div class="data-block">
      <p><strong>Fecha del acta:</strong> Tegucigalpa, M.D.C. — 10 agosto de 2026</p>
      <p><strong>Nombre del trabajador(a):</strong> Ana Ficticia López</p>
      <p><strong>N.º de identidad:</strong> 0801-1990-12345</p>
      <p><strong>Cargo desempeñado:</strong> Analista</p>
      <p><strong>Fecha efectiva de terminación:</strong> Tegucigalpa, M.D.C. — 10 agosto de 2026</p>
    </div>
    <p>Por medio de la presente se deja constancia de que, a partir de la fecha efectiva de terminación indicada arriba, la relación laboral entre el trabajador(a) antes identificado(a) y el <strong>CONSEJO NACIONAL DE INVERSIONES (CNI)</strong> concluye formalmente. En consecuencia, se solicita al trabajador(a) la devolución de todo el equipo informático, licencias de software, contraseñas, llaves y demás recursos de la institución que se encuentren bajo su custodia.</p>
    <p>A continuación, se detalla el inventario de equipo y recursos devueltos por el trabajador(a), así como el estado en que fueron recibidos:</p>
    <h2 class="section">Equipo informático</h2><table class="inventory"><thead><tr><th>No.</th><th>Ítem</th><th>Marca/Modelo</th><th>Serie</th><th>Observaciones</th></tr></thead><tbody><tr><td>1</td><td>LAPTOP</td><td>Dell Latitude</td><td>SN-1</td><td>—</td></tr></tbody></table>
    <h2 class="section">Accesorios y periféricos</h2><table class="inventory"><thead><tr><th>No.</th><th>Ítem</th><th>Cantidad</th><th>Estado</th><th>Observaciones</th></tr></thead><tbody><tr><td>1</td><td>Sin ítems</td><td>Sin ítems</td><td>Sin ítems</td><td>Sin ítems</td></tr></tbody></table>
    <h2 class="section">Licencias de software</h2><table class="inventory"><thead><tr><th>No.</th><th>Software</th><th>N.º de licencia</th><th>Observaciones</th></tr></thead><tbody><tr><td>1</td><td>Windows</td><td>•••••AB12X</td><td>—</td></tr></tbody></table>
    <h2 class="section">Contraseñas y accesos</h2><table class="inventory"><thead><tr><th>No.</th><th>Sistema/Acceso</th><th>Entregado/Revocado</th><th>Observaciones</th></tr></thead><tbody><tr><td>1</td><td>Sin ítems</td><td>Sin ítems</td><td>Sin ítems</td></tr></tbody></table>
    <h2 class="section">Objetos varios</h2><table class="inventory"><thead><tr><th>No.</th><th>Ítem</th><th>Estado</th><th>Observaciones</th></tr></thead><tbody><tr><td>1</td><td>Sin ítems</td><td>Sin ítems</td><td>Sin ítems</td></tr></tbody></table>
    <p><strong>Confidencialidad y destrucción de información:</strong> toda la información relacionada con contraseñas y accesos deberá ser proporcionada de forma segura y confidencial. Asimismo, el trabajador(a) se compromete a eliminar y/o destruir cualquier copia física o digital de información propiedad del CNI que se encuentre en su posesión.</p>
    <p><strong>Coordinación de la entrega:</strong> la entrega de los ítems deberá coordinarse con el Departamento de Informática y Tecnología, el cual estará disponible para recibir el equipo y brindar la asistencia necesaria.</p>
    <p><strong>Declaración de conformidad:</strong> las partes que suscriben declaran que el presente inventario refleja de manera fiel y completa el equipo y los recursos devueltos, y que no existen pendientes adicionales distintos a los aquí señalados, salvo que se indique lo contrario en observaciones.</p>
    <p>Se agradece la colaboración prestada y se desea el mayor de los éxitos en los proyectos profesionales futuros.</p>
    <p><strong>En fe de lo anterior, firman:</strong></p>
    <div class="signatures">
      <div class="signature">
    <div class="sig-line"></div>
    <p class="sig-label">Firma del Trabajador(a)</p>
    <p>Ana Ficticia López</p>
    <p class="sig-meta">N.º de identidad: 0801-1990-12345</p>
    <p class="sig-meta">Fecha: 10/08/2026</p>
  </div>
      <div class="signature">
    <div class="sig-line"></div>
    <p class="sig-label">Recibido por — Informática y Tecnología</p>
    <p>Nombre: CARLOS FICTICIO MEJÍA</p>
    <p class="sig-meta">Cargo: Jefe de activos</p>
    <p class="sig-meta">Fecha: 10/08/2026</p>
  </div>
    </div>
  
    <p class="note">Nota de confidencialidad: Este documento contiene información interna del CNI sobre activos y licencias. Queda terminantemente prohibida su difusión externa sin autorización expresa de la Dirección correspondiente.</p>
  </div>
  <footer class="acta-footer">
    <span>Centro Cívico Gubernamental, Blvd. Juan Pablo II, / Diag. República de Corea, Tegucigalpa</span>
    <span>Tel. +504 2242-8955 / www.cni.hn</span>
  </footer>
</body>
</html>"
`;

exports[`actas CNI HTML > acta de devolución — motivo sustitución 1`] = `
