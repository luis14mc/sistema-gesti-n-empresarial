{
  "name": "sistema-gestion-empresarial",
  "version": "1.0.0",
  "type": "module",
  "description": "Sistema multifuncional de gestión empresarial con módulos de oficios, equipos, asignaciones, compras, usuarios y auditoría",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
