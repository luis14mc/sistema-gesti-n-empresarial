{
  "name": "sistema-gestion-empresarial",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0 <23 || >=24 <25",
    "pnpm": "9.15.9"
  },
  "description": "Sistema multifuncional de gestión empresarial con módulos de oficios, equipos, asignaciones, compras, usuarios y auditoría",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "pnpm build:web && pnpm build:worker",
    "build:web": "next build",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/worker/index.js",
    "start": "pnpm start:web",
    "start:web": "node .next/standalone/server.js",
    "start:worker": "node dist/worker/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=junit --outputFile.junit=reports/junit.xml",
    "test:integration": "SGE_LIVE_DB=true vitest run tests/integration tests/migrations",
    "test:regression": "vitest run tests/security tests/contracts",
    "test:unit": "vitest run tests/unit __tests__/domain-foundations.test.ts __tests__/permissions.test.ts __tests__/auth.test.ts __tests__/jwt.test.ts __tests__/notifications-dispatcher.test.ts",
    "test:report": "node scripts/test-report.mjs",
    "test:e2e": "playwright test",
    "playwright": "playwright",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "compras:repair-drafts": "tsx scripts/repair-purchase-order-drafts.ts",
    "organizations:backfill": "tsx scripts/backfill-default-organization.ts",
    "saas:bootstrap": "tsx scripts/bootstrap-default-organization.ts",
    "saas:check": "tsx scripts/check-tenant-bootstrap.ts",
    "browser:install": "puppeteer browsers install chrome",
    "browser:list": "puppeteer browsers list",
    "docker:up": "docker compose up -d db",
    "docker:up:s3": "docker compose --profile storage up -d minio minio-init",
    "docker:full": "docker compose --profile full up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-query": "^5.90.20",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.575.0",
    "next": "16.2.11",
    "pg": "8.22.0",
    "puppeteer": "25.3.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.7",
    "react-datepicker": "^9.0.0",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.71.2",
    "react-icons": "^5.5.0",
    "recharts": "^3.7.0",
    "sileo": "^0.1.5",
    "sweetalert2": "^11.26.20",
    "tailwind-merge": "^3.5.0",
    "zod": "4.4.3",
    "zustand": "^5.0.11"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.10",
      "fast-uri": "3.1.4",
      "find-my-way": "9.7.0",
      "postcss": "8.5.22",
      "sharp": "0.35.0"
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.2",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.8",
    "autoprefixer": "^10.4.24",
    "esbuild": "0.28.1",
    "eslint": "^9.28.0",
    "eslint-config-next": "16.2.11",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.19",
    "prisma": "7.9.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
