# Runtime identity
NODE_ENV="development"
APP_ENV="development" # development | test | staging | production
APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="" # Empty means same origin

# Database. Runtime uses the pooler; Prisma CLI uses the direct URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_POOL_MAX="10"
DATABASE_IDLE_TIMEOUT_MS="30000"
DATABASE_CONNECTION_TIMEOUT_MS="5000"

# Authentication. Generate JWT_SECRET with: openssl rand -base64 48
JWT_SECRET="REPLACE_WITH_A_CRYPTOGRAPHIC_SECRET_OF_AT_LEAST_32_CHARACTERS"
COOKIE_SECURE="false" # Must be true in staging and production
CORS_ORIGINS="" # Comma-separated; empty keeps same-origin behavior

# Logging and health
LOG_LEVEL="debug"
HEALTH_CHECK_TIMEOUT_MS="3000"
NEXT_TELEMETRY_DISABLED="1"

# Storage. Staging and production require s3.
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./public"
AWS_REGION="us-east-2"
S3_BUCKET=""
S3_PUBLIC_URL=""
S3_PRESIGNED_TTL_SECONDS="900"
S3_ENDPOINT="" # Development/test S3-compatible endpoint only
S3_FORCE_PATH_STYLE="false"

# Optional development/test static credentials. ECS uses its IAM task role.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""

# PDF engine. Production image provides /opt/chrome/chrome.
PDF_ENGINE_REQUIRED="true"
PUPPETEER_EXECUTABLE_PATH=""
PUPPETEER_DISABLE_SANDBOX="false"

# Worker runtime. Keep disabled until the database-backed processor is implemented.
WORKER_ENABLED="false"
WORKER_PAUSED="false"
WORKER_POLL_INTERVAL_MS="2000"
WORKER_SHUTDOWN_TIMEOUT_MS="25000"

# Reporting
REPORT_MAX_RANGE_DAYS="366"

# Initial organization bootstrap. Never run destructive bootstrap against production.
DEFAULT_ORGANIZATION_ID="org_cni_default"
DEFAULT_ORGANIZATION_SLUG="cni"
DEFAULT_ORGANIZATION_NAME="Consejo Nacional de Inversiones"

# Institutional document defaults
INSTITUTION_NAME="Sistema de Gestión Empresarial"
INSTITUTION_LOGO_PATH="/Logo_CNI.png"
INSTITUTION_ADDRESS=""
INSTITUTION_PHONE=""
INSTITUTION_WEBSITE=""
