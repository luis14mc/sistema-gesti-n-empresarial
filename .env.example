# ==================================================
# Local development defaults
# ==================================================
NODE_ENV="development"
APP_ENV="development" # development | test | staging | production
APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="" # Empty means same origin

# PostgreSQL
# Runtime uses DATABASE_URL. Prisma CLI prefers DIRECT_URL when present.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
DATABASE_POOL_MAX="10"
DATABASE_IDLE_TIMEOUT_MS="30000"
DATABASE_CONNECTION_TIMEOUT_MS="5000"

# Authentication. Generate JWT_SECRET with: openssl rand -base64 48
JWT_SECRET="REPLACE_WITH_A_CRYPTOGRAPHIC_SECRET_OF_AT_LEAST_32_CHARACTERS"
COOKIE_SECURE="false" # Must be true in staging and production
CORS_ORIGINS="" # Comma-separated; empty keeps same-origin behavior

# Logging and health
LOG_LEVEL="debug"
HEALTH_CHECK_TIMEOUT_MS="3000"
NEXT_TELEMETRY_DISABLED="1"

# Storage
# Local storage is acceptable for development only. Railway staging/production
# should use an S3-compatible bucket for persistent uploaded files and PDFs.
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./public"
AWS_REGION="us-east-2"
S3_BUCKET=""
S3_PUBLIC_URL=""
S3_PRESIGNED_TTL_SECONDS="900"
S3_ENDPOINT="" # Development/test S3-compatible endpoint only
S3_FORCE_PATH_STYLE="false"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""

# PDF engine
# Railway Docker runtime installs Chromium at /usr/bin/chromium.
PDF_ENGINE_REQUIRED="true"
PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"
PUPPETEER_DISABLE_SANDBOX="true"

# Worker runtime. Keep disabled until the DB-backed processor is intentionally enabled.
WORKER_ENABLED="false"
WORKER_PAUSED="false"
WORKER_POLL_INTERVAL_MS="2000"
WORKER_SHUTDOWN_TIMEOUT_MS="25000"

# Reporting
REPORT_MAX_RANGE_DAYS="366"

# Initial organization bootstrap. Never run destructive bootstrap against production.
DEFAULT_ORGANIZATION_ID="org_cni_default"
DEFAULT_ORGANIZATION_SLUG="cni"
DEFAULT_ORGANIZATION_NAME="Consejo Nacional de Inversiones"

# Institutional document defaults
INSTITUTION_NAME="Consejo Nacional de Inversiones"
INSTITUTION_LOGO_PATH="/Logo_CNI.png"
INSTITUTION_ADDRESS=""
INSTITUTION_PHONE=""
INSTITUTION_WEBSITE=""

# ==================================================
# Railway staging example
# ==================================================
# Configure these as Railway service variables; do not commit real credentials.
#
# NODE_ENV=production
# APP_ENV=staging
# APP_URL=https://YOUR-SERVICE.up.railway.app
# NEXT_PUBLIC_API_URL=
#
# Add a Railway PostgreSQL service to the same project and reference its
# DATABASE_URL from this web service. For staging it is valid to use the same
# PostgreSQL connection string for DATABASE_URL and DIRECT_URL.
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DIRECT_URL=${{Postgres.DATABASE_URL}}
#
# Controlled CNI master-data seed. Default is disabled. Set true only for the
# deployment that should load/update the versioned provider/employee catalogs,
# then set it back to false (or remove it) immediately after a successful seed.
# SEED_CNI_MASTER_DATA=false
#
# JWT_SECRET=<openssl rand -base64 48>
# COOKIE_SECURE=true
# CORS_ORIGINS=
#
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_CONNECTION_TIMEOUT_MS=5000
# LOG_LEVEL=debug
# HEALTH_CHECK_TIMEOUT_MS=3000
# NEXT_TELEMETRY_DISABLED=1
#
# WORKER_ENABLED=false
# WORKER_PAUSED=false
# PDF_ENGINE_REQUIRED=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_DISABLE_SANDBOX=true
#
# Railway injects PORT automatically. Do not define PORT unless you intentionally
# need to override Railway's assigned port.
