# =====================================================
# SGE — Variables de Entorno (PLANTILLA)
# Copiar a .env y completar con valores reales.
# NUNCA commitear .env al repositorio.
# =====================================================

# Base de datos - PostgreSQL (Neon, RDS o self-hosted)
# Runtime: usa el POOLER. Prisma CLI: usa la DIRECTA.
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST-pooler.region.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USUARIO:PASSWORD@HOST.region.aws.neon.tech/DB?sslmode=require"

# JWT — Clave de firma de tokens (mín. 32 caracteres, criptográficamente segura)
# Generar con: openssl rand -base64 48
JWT_SECRET="REEMPLAZAR_POR_CLAVE_SEGURA_DE_AL_MENOS_32_CARACTERES"

# URL pública del API (vacío = mismo origen en Next.js)
NEXT_PUBLIC_API_URL=""

# =====================================================
# Storage (Sprint 2 — Migración a S3)
# =====================================================
# Driver: "local" (desarrollo) o "s3" (producción)
STORAGE_DRIVER="local"

# Local storage (solo cuando STORAGE_DRIVER=local)
LOCAL_STORAGE_PATH="./public/uploads"

# AWS S3 (cuando STORAGE_DRIVER=s3)
AWS_REGION="us-east-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="sge-uploads"
S3_PUBLIC_URL=""                # Opcional: CDN público (CloudFront)
S3_PRESIGNED_TTL_SECONDS="900"  # 15 min por defecto

# =====================================================
# Aplicación
# =====================================================
NODE_ENV="development"
NEXT_TELEMETRY_DISABLED="1"
