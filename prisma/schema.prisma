generator client {
  provider      = "prisma-client-js"
  compilerBuild = "fast"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                     String                     @id @default(cuid())
  name                   String
  slug                   String                     @unique
  legalName              String?
  rtn                    String?
  logoKey                String?
  status                 OrganizationStatus         @default(ACTIVE)
  settings               Json?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  memberships            OrganizationMembership[]
  equipment              Equipment[]
  disposals              EquipmentDisposal[]
  disposalPolicies       DisposalPolicy[]
  disposalDocuments      DisposalDocument[]
  disposalHistory        EquipmentDisposalHistory[]
  documentSequences      DocumentSequence[]
  replacementProjections ReplacementProjection[]
  purchaseOrders         CompraOrden[]
  auditRecords           AuditRecord[]
  equipmentAssignments   EquipmentAssignment[]
  tickets                Ticket[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
  @@map("organization_memberships")
}

model Department {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  employees   Employee[]
  positions   JobPosition[]
  users       User[]

  @@map("departments")
}

model JobPosition {
  id           String     @id @default(cuid())
  name         String     @unique
  departmentId String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  employees    Employee[]
  department   Department @relation(fields: [departmentId], references: [id])
  users        User[]

  @@index([departmentId])
  @@map("job_positions")
}

model AttendancePolicy {
  id               String  @id @default(cuid())
  name             String
  officialCheckIn  String
  officialCheckOut String
  toleranceMinutes Int     @default(15)
  isActive         Boolean @default(true)

  @@map("attendance_policies")
}

model User {
  id                           String                       @id @default(cuid())
  employeeNumber               String                       @unique
  email                        String                       @unique
  password                     String
  firstName                    String
  lastName                     String
  phone                        String?
  role                         Role                         @default(USER)
  isActive                     Boolean                      @default(true)
  departmentId                 String?
  positionId                   String?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  auditRecords                 AuditRecord[]                @relation("AuditUser")
  auditsCreated                Audit[]                      @relation("AuditCreator")
  auditsLed                    Audit[]                      @relation("AuditLeadAuditor")
  comprasAdjuntos              CompraAdjunto[]              @relation("CompraAdjuntoUploader")
  comprasDocumentos            CompraDocumento[]
  comprasSolicitadas           CompraSolicitud[]            @relation("CompraSolicitante")
  comprasOrdenesCreadas        CompraOrden[]                @relation("CompraOrdenCreatedBy")
  comprasOrdenesGeneradas      CompraOrden[]                @relation("CompraOrdenGeneratedBy")
  comprasOrdenesEmitidas       CompraOrden[]                @relation("CompraOrdenIssuedBy")
  comprasOrdenesAnuladas       CompraOrden[]                @relation("CompraOrdenCancelledBy")
  comprasOrdenesCerradas       CompraOrden[]                @relation("CompraOrdenClosedBy")
  comprasOrdenDocumentos       CompraOrdenDocumento[]       @relation("CompraOrdenDocumentoUploader")
  comprasOrdenHistorial        CompraOrdenHistorial[]       @relation("CompraOrdenHistorialPerformer")
  comprasOrdenTemplates        CompraOrdenTemplate[]        @relation("CompraOrdenTemplateCreator")
  comprasOrdenDocumentosLegacy CompraOrdenDocumentoLegacy[] @relation("CompraOrdenDocumentoLegacy")
  comprasOrdenHistorialLegacy  CompraOrdenHistorialLegacy[] @relation("CompraOrdenHistorialLegacy")
  correctiveActions            CorrectiveAction[]           @relation("CorrectiveActionResponsible")
  employeeProfile              Employee?
  equipmentAssigned            EquipmentAssignment[]
  oficioDocuments              OficioDocument[]             @relation("OficioDocumentUploader")
  oficioTrackingEntries        OficioTracking[]             @relation("OficioTrackingPerformer")
  oficioImportBatches          OficioImportBatch[]          @relation("OficioImportBatchPerformer")
  oficiosCreated               Oficio[]                     @relation("OficioCreator")
  oficiosImported              Oficio[]                     @relation("OficioImporter")
  ticketsAssigned              Ticket[]                     @relation("TicketAssignee")
  ticketsCreated               Ticket[]                     @relation("TicketCreator")
  timeEntries                  TimeEntry[]
  department                   Department?                  @relation(fields: [departmentId], references: [id])
  position                     JobPosition?                 @relation(fields: [positionId], references: [id])
  organizationMemberships      OrganizationMembership[]
  disposalsEvaluated           EquipmentDisposal[]          @relation("DisposalEvaluator")
  disposalsApproved            EquipmentDisposal[]          @relation("DisposalApprover")
  disposalDocumentsUploaded    DisposalDocument[]           @relation("DisposalDocumentUploader")
  disposalHistory              EquipmentDisposalHistory[]   @relation("DisposalHistoryPerformer")

  @@index([departmentId])
  @@index([positionId])
  @@index([role])
  @@map("users")
}

model AuditRecord {
  id             String        @id @default(cuid())
  title          String
  description    String
  justification  String?
  module         String
  category       String
  priority       String
  status         String
  deliveryDate   DateTime?
  receptionDate  DateTime?
  closingDate    DateTime?
  attachments    Json?
  comments       String?
  entityId       String?
  previousData   Json?
  newData        Json?
  userId         String?
  organizationId String?
  entityType     String?
  action         String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime      @default(now())
  user           User?         @relation("AuditUser", fields: [userId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([module])
  @@index([entityId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_records")
}

model TimeEntry {
  id        String           @id @default(cuid())
  userId    String
  date      DateTime         @db.Date
  checkIn   DateTime?
  checkOut  DateTime?
  latitude  Float
  longitude Float
  status    AttendanceStatus @default(ON_TIME)
  notes     String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("time_entries")
}

model Ticket {
  id             String         @id @default(cuid())
  title          String
  description    String
  type           String
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  attachments    Json?
  comments       Json?
  createdById    String
  assignedToId   String?
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedTo     User?          @relation("TicketAssignee", fields: [assignedToId], references: [id])
  createdBy      User           @relation("TicketCreator", fields: [createdById], references: [id])

  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
  @@index([organizationId, status])
  @@map("tickets")
}

model Oficio {
  id           String             @id @default(cuid())
  number       String
  systemNumber String?            @unique
  type         OficioType
  subject      String
  status       OficioStatus       @default(DRAFT)
  attachments  Json?
  comments     String?
  oficioDate   DateTime           @db.Date
  receivedDate DateTime?          @db.Date
  sentDate     DateTime?          @db.Date
  recordSource OficioRecordSource @default(SYSTEM_CREATED)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  institution String?
  preparedBy  String?
  recipient   String?
  scope       String?

  importedById String?
  importedAt   DateTime?

  createdBy  User  @relation("OficioCreator", fields: [createdById], references: [id])
  importedBy User? @relation("OficioImporter", fields: [importedById], references: [id])

  documents              OficioDocument[]
  tracking               OficioTracking[]
  importBatches          OficioImportBatch[]
  oficioImportBatchItems OficioImportBatchItem[]

  @@index([number])
  @@index([institution, number])
  @@index([createdById])
  @@index([status])
  @@index([type])
  @@index([scope])
  @@index([recordSource])
  @@index([oficioDate])
  @@map("oficios")
}

model OficioDocument {
  id           String   @id @default(cuid())
  oficioId     String
  filename     String
  originalName String
  mimeType     String
  size         Int
  storageKey   String
  url          String
  fileHash     String?
  documentType String   @default("OFICIO_PRINCIPAL")
  isPrimary    Boolean  @default(false)
  version      Int      @default(1)
  uploadedById String
  uploadedAt   DateTime @default(now())

  oficio     Oficio @relation(fields: [oficioId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("OficioDocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([oficioId])
  @@index([fileHash])
  @@index([documentType])
  @@map("oficio_documents")
}

model OficioTracking {
  id            String               @id @default(cuid())
  oficioId      String
  action        OficioTrackingAction
  title         String
  description   String?
  previousData  Json?
  newData       Json?
  performedById String
  createdAt     DateTime             @default(now())

  oficio      Oficio @relation(fields: [oficioId], references: [id], onDelete: Cascade)
  performedBy User   @relation("OficioTrackingPerformer", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([oficioId])
  @@index([action])
  @@index([createdAt])
  @@map("oficio_tracking")
}

model OficioImportBatch {
  id            String                  @id @default(cuid())
  source        OficioRecordSource      @default(HISTORICAL_IMPORT)
  status        OficioImportBatchStatus @default(PENDING)
  totalFiles    Int                     @default(0)
  imported      Int                     @default(0)
  skipped       Int                     @default(0)
  errors        Int                     @default(0)
  notes         String?
  performedById String
  startedAt     DateTime                @default(now())
  finishedAt    DateTime?

  performedBy User                    @relation("OficioImportBatchPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  items       OficioImportBatchItem[]
  oficio      Oficio?                 @relation(fields: [oficioId], references: [id])
  oficioId    String?

  @@index([performedById])
  @@index([status])
  @@map("oficio_import_batches")
}

model OficioImportBatchItem {
  id           String                      @id @default(cuid())
  batchId      String
  rowIndex     Int
  status       OficioImportBatchItemStatus @default(PENDING)
  originalName String?
  number       String?
  institution  String?
  oficioDate   DateTime?                   @db.Date
  fileHash     String?
  errorMessage String?
  oficioId     String?

  batch  OficioImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  oficio Oficio?           @relation(fields: [oficioId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([status])
  @@map("oficio_import_batch_items")
}

model Employee {
  id           String                @id @default(cuid())
  employeeCode String?               @unique
  firstName    String
  lastName     String
  fullName     String
  email        String                @unique
  phone        String?
  dni          String?
  userId       String?               @unique
  departmentId String?
  positionId   String?
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  department   Department?           @relation(fields: [departmentId], references: [id])
  position     JobPosition?          @relation(fields: [positionId], references: [id])
  user         User?                 @relation(fields: [userId], references: [id])
  assignments  EquipmentAssignment[]

  @@index([departmentId])
  @@index([positionId])
  @@index([email])
  @@map("employees")
}

model Equipment {
  id                     String                  @id @default(cuid())
  inventoryCode          String                  @unique
  type                   String
  brand                  String
  model                  String
  serialNumber           String?                 @unique
  status                 EquipmentStatus         @default(AVAILABLE)
  purchaseDate           DateTime?               @db.Date
  warrantyDate           DateTime?               @db.Date
  depreciationDate       DateTime?               @db.Date
  ram                    String?
  processor              String?
  storage                String?
  os                     String?
  retirementReason       String?
  retiredAt              DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  category               EquipmentCategory       @default(OTHER)
  cost                   Float?
  ipAddress              String?
  location               String?
  macAddress             String?
  notes                  String?
  purchaseOrder          String?
  supplier               String?
  organizationId         String?
  organization           Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments            EquipmentAssignment[]
  history                EquipmentHistory[]
  maintenances           EquipmentMaintenance[]
  disposals              EquipmentDisposal[]
  replacementProjections ReplacementProjection[]

  @@index([status])
  @@index([category])
  @@index([type])
  @@index([inventoryCode])
  @@index([serialNumber])
  @@index([organizationId, status])
  @@map("equipment")
}

model EquipmentAssignment {
  id                  String           @id @default(cuid())
  equipmentId         String
  userId              String?
  assignedDate        DateTime         @default(now())
  returnedDate        DateTime?
  departmentAtTime    String?
  positionAtTime      String?
  notes               String?
  urlNotaPdf          String?
  assignedById        String?
  assignmentNotes     String?
  createdAt           DateTime         @default(now())
  deliveryDocumentUrl String?
  deliveryReason      String?
  employeeEmailAtTime String?
  employeeId          String?
  employeeNameAtTime  String?
  returnCondition     String?
  returnDocumentUrl   String?
  returnNotes         String?
  returnReason        String?
  returnedById        String?
  updatedAt           DateTime         @default(now()) @updatedAt
  status              AssignmentStatus @default(ACTIVE)
  organizationId      String?
  organization        Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee            Employee?        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  equipment           Equipment        @relation(fields: [equipmentId], references: [id])
  user                User?            @relation(fields: [userId], references: [id])

  @@index([equipmentId])
  @@index([employeeId])
  @@index([userId])
  @@index([status])
  @@index([assignedDate])
  @@index([organizationId, status])
  @@map("equipment_assignments")
}

model EquipmentHistory {
  id            String                 @id @default(cuid())
  equipmentId   String
  action        EquipmentHistoryAction
  title         String
  description   String?
  previousData  Json?
  newData       Json?
  performedById String?
  createdAt     DateTime               @default(now())
  equipment     Equipment              @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([action])
  @@index([createdAt])
  @@map("equipment_history")
}

model PromotionalItem {
  id            String                @id @default(cuid())
  inventoryCode String                @unique
  name          String
  description   String?
  quantity      Int                   @default(0)
  unitPrice     Float
  purchaseDate  DateTime              @db.Date
  status        String                @default("ACTIVE")
  createdAt     DateTime              @default(now())
  movements     PromotionalMovement[]

  @@map("promotional_items")
}

model PromotionalMovement {
  id             String          @id @default(cuid())
  itemId         String
  type           MovementType
  quantityOut    Int
  quantityReturn Int?            @default(0)
  movementDate   DateTime        @db.Date
  returnDate     DateTime?       @db.Date
  eventName      String?
  eventLocation  String?
  eventDate      DateTime?       @db.Date
  responsible    String?
  comments       String?
  createdAt      DateTime        @default(now())
  item           PromotionalItem @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@map("promotional_movements")
}

model CostCenter {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cost_centers")
}

model Proveedor {
  id                 String            @id @default(cuid())
  nombreRazonSocial  String
  rtn                String?
  telefono           String?
  email              String?
  personaContacto    String?
  direccion          String?
  activo             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  comprasSolicitudes CompraSolicitud[]
  comprasOrdenes     CompraOrden[]

  @@index([activo])
  @@index([nombreRazonSocial])
  @@map("proveedores")
}

model CompraSequence {
  id        String @id @default(cuid())
  year      Int
  prefix    String @default("OC-CNI")
  lastValue Int    @default(0)

  @@unique([year, prefix])
  @@map("compras_sequences")
}

model CompraSolicitud {
  id               String       @id @default(cuid())
  numeroOrden      String?      @unique
  referenciaCompra String?
  fechaSolicitud   DateTime     @default(now()) @db.Date
  fechaRequerida   DateTime?    @db.Date
  solicitadoPorId  String
  cargoSolicitante String?
  estado           CompraEstado @default(BORRADOR)

  proveedorId             String?
  proveedorNombre         String?
  proveedorIdentificacion String?
  proveedorTelefono       String?
  proveedorEmail          String?
  proveedorContacto       String?
  proveedorDireccion      String? @db.Text

  justificacionCompra      String  @default("")
  observacionesAdicionales String?

  subtotal  Float @default(0)
  descuento Float @default(0)
  impuesto  Float @default(0)
  total     Float @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  adjuntos      CompraAdjunto[]
  documentos    CompraDocumento[]
  items         CompraSolicitudItem[]
  proveedor     Proveedor?            @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  solicitadoPor User                  @relation("CompraSolicitante", fields: [solicitadoPorId], references: [id], onDelete: Restrict)

  @@index([estado])
  @@index([solicitadoPorId])
  @@index([fechaSolicitud])
  @@index([numeroOrden])
  @@index([proveedorId])
  @@map("compras_solicitudes")
}

model CompraSolicitudItem {
  id                String          @id @default(cuid())
  solicitudCompraId String
  item              Int
  codigo            String?
  descripcion       String
  unidad            CompraUnidad    @default(UNIDAD)
  cantidad          Float
  precioUnitario    Float
  total             Float
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  solicitud         CompraSolicitud @relation(fields: [solicitudCompraId], references: [id], onDelete: Cascade)

  @@index([solicitudCompraId])
  @@map("compras_solicitud_items")
}

model CompraAdjunto {
  id                String            @id @default(cuid())
  solicitudCompraId String
  tipoAdjunto       CompraTipoAdjunto @default(OTRO)
  nombre            String
  mimeType          String
  size              Int
  storagePath       String
  url               String
  uploadedById      String
  uploadedAt        DateTime          @default(now())
  solicitud         CompraSolicitud   @relation(fields: [solicitudCompraId], references: [id], onDelete: Cascade)
  uploadedBy        User              @relation("CompraAdjuntoUploader", fields: [uploadedById], references: [id])

  @@index([solicitudCompraId])
  @@map("compras_adjuntos")
}

model EquipmentMaintenance {
  id            String            @id @default(cuid())
  equipmentId   String
  type          MaintenanceType   @default(PREVENTIVE)
  status        MaintenanceStatus @default(SCHEDULED)
  description   String
  scheduledDate DateTime?         @db.Date
  completedDate DateTime?         @db.Date
  cost          Float?
  technician    String?
  notes         String?
  performedById String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  documentUrl   String?
  equipment     Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([status])
  @@index([scheduledDate])
  @@map("equipment_maintenances")
}

model Audit {
  id              String               @id @default(cuid())
  code            String               @unique
  title           String
  description     String?
  type            AuditType            @default(INTERNAL)
  status          AuditStatus          @default(PLANNED)
  standard        String?
  scope           String?
  objectives      String?
  criteria        String?
  department      String?
  conclusions     String?
  recommendations String?
  auditeeContact  String?
  plannedDate     DateTime?            @db.Date
  startDate       DateTime?
  endDate         DateTime?
  leadAuditorId   String?
  createdById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  checklist       AuditChecklistItem[]
  findings        AuditFinding[]
  createdBy       User?                @relation("AuditCreator", fields: [createdById], references: [id])
  leadAuditor     User?                @relation("AuditLeadAuditor", fields: [leadAuditorId], references: [id])

  @@index([status])
  @@index([leadAuditorId])
  @@index([plannedDate])
  @@map("audits")
}

model AuditFinding {
  id          String               @id @default(cuid())
  auditId     String
  code        String?
  description String
  evidence    String?
  severity    AuditFindingSeverity
  clause      String?
  status      String               @default("OPEN")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  audit       Audit                @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([severity])
  @@map("audit_findings")
}

model AuditChecklistItem {
  id          String           @id @default(cuid())
  auditId     String
  description String?
  requirement String
  clause      String?
  sortOrder   Int              @default(0)
  completed   Boolean          @default(false)
  result      ChecklistResult?
  notes       String?
  evidence    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  audit       Audit            @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([sortOrder])
  @@map("audit_checklist_items")
}

model CorrectiveAction {
  id            String                 @id @default(cuid())
  findingId     String?
  auditId       String?
  description   String
  responsibleId String?
  dueDate       DateTime?              @db.Date
  completedDate DateTime?
  status        CorrectiveActionStatus @default(PENDING)
  evidence      String?
  notes         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  responsible   User?                  @relation("CorrectiveActionResponsible", fields: [responsibleId], references: [id])

  @@index([findingId])
  @@index([auditId])
  @@index([status])
  @@index([responsibleId])
  @@map("corrective_actions")
}

model CompraDocumento {
  id                String              @id
  solicitudCompraId String
  tipoDocumento     CompraTipoDocumento @default(ORDEN_COMPRA_PDF)
  nombreArchivo     String
  mimeType          String              @default("application/pdf")
  storagePath       String
  url               String
  version           Int                 @default(1)
  activo            Boolean             @default(true)
  generadoEn        DateTime            @default(now())
  generadoPorId     String
  generadoPor       User                @relation(fields: [generadoPorId], references: [id])
  solicitud         CompraSolicitud     @relation(fields: [solicitudCompraId], references: [id], onDelete: Cascade)

  @@index([solicitudCompraId, activo])
  @@index([solicitudCompraId])
  @@index([solicitudCompraId, tipoDocumento])
  @@map("compras_documentos")
}

// ── Órdenes de compra — flujo administrativo (tabla activa) ───

model CompraOrden {
  id                    String              @id @default(cuid())
  orderNumber           String?             @unique
  sequenceNumber        Int?
  sequenceYear          Int?
  purchaseReference     String
  requestDate           DateTime            @default(now()) @db.Date
  requiredDate          DateTime            @db.Date
  requestedByName       String
  requesterJobTitle     String
  supplierId            String?
  supplierName          String
  supplierRtn           String
  supplierPhone         String
