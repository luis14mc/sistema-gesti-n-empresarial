generator client {
  provider      = "prisma-client-js"
  compilerBuild = "fast"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// MÓDULO DE USUARIOS Y AJUSTES
// ============================================

enum Role {
  ADMIN
  USER
  RRHH
  IT
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  users     User[]
  employees Employee[]
  positions JobPosition[]

  @@map("departments")
}

model JobPosition {
  id           String     @id @default(cuid())
  name         String     @unique
  departmentId String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  users      User[]
  employees  Employee[]

  @@index([departmentId])
  @@map("job_positions")
}

model AttendancePolicy {
  id               String  @id @default(cuid())
  name             String
  officialCheckIn  String // ej: "08:00"
  officialCheckOut String // ej: "17:00"
  toleranceMinutes Int     @default(15)
  isActive         Boolean @default(true)

  @@map("attendance_policies")
}

model User {
  id             String       @id @default(cuid())
  employeeNumber String       @unique
  email          String       @unique
  password       String
  firstName      String
  lastName       String
  phone          String?
  role           Role         @default(USER)
  isActive       Boolean      @default(true)
  departmentId   String?
  positionId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  department Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position   JobPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  ticketsCreated      Ticket[]              @relation("TicketCreator")
  ticketsAssigned     Ticket[]              @relation("TicketAssignee")
  oficiosCreated      Oficio[]              @relation("OficioCreator")
  timeEntries         TimeEntry[]
  equipmentAssigned   EquipmentAssignment[]
  employeeProfile     Employee?
  purchaseRequests    PurchaseRequest[]     @relation("PurchaseRequester")
  auditRecords        AuditRecord[]         @relation("AuditUser")
  auditsLed           Audit[]               @relation("AuditLeadAuditor")
  auditsCreated       Audit[]               @relation("AuditCreator")
  correctiveActions   CorrectiveAction[]   @relation("CorrectiveActionResponsible")

  @@index([departmentId])
  @@index([positionId])
  @@index([role])
  @@map("users")
}

// ============================================
// MÓDULO DE AUDITORÍAS (TRANSVERSAL E INTERNA)
// ============================================

model AuditRecord {
  id            String    @id @default(cuid())
  title         String
  description   String    @db.Text
  justification String?   @db.Text
  module        String // TICKETS, OFICIOS, EQUIPOS, ASISTENCIA, MANUAL
  category      String
  priority      String // BAJA, MEDIA, ALTA, URGENTE
  status        String
  deliveryDate  DateTime?
  receptionDate DateTime?
  closingDate   DateTime?
  attachments   Json?
  comments      String?   @db.Text

  entityId     String?
  previousData Json?
  newData      Json?

  userId String?
  user   User?   @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_records")
}

// ============================================
// MÓDULO DE ASISTENCIA
// ============================================

enum AttendanceStatus {
  ON_TIME
  LATE
  ABSENT
  EXCUSED
}

model TimeEntry {
  id        String           @id @default(cuid())
  userId    String
  date      DateTime         @db.Date
  checkIn   DateTime?
  checkOut  DateTime?
  latitude  Float
  longitude Float
  status    AttendanceStatus @default(ON_TIME)
  notes     String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("time_entries")
}

// ============================================
// MÓDULO DE TICKETS DE SOPORTE
// ============================================

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Ticket {
  id           String         @id @default(cuid())
  title        String
  description  String         @db.Text
  type         String
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  attachments  Json?
  comments     Json?
  createdById  String
  assignedToId String?
  closedAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  createdBy  User  @relation("TicketCreator", fields: [createdById], references: [id])
  assignedTo User? @relation("TicketAssignee", fields: [assignedToId], references: [id])

  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
  @@map("tickets")
}

// ============================================
// MÓDULO DE OFICIOS Y MEMOS
// ============================================

enum OficioType {
  INCOMING
  OUTGOING
  INTERNAL_MEMO
}

enum OficioStatus {
  DRAFT
  SENT
  RECEIVED
  IN_PROCESS
  COMPLETED
  ARCHIVED
}

model Oficio {
  id          String     @id @default(cuid())
  number      String     @unique
  type        OficioType
  scope       String?
  subject     String
  recipient   String?
  institution String?
  preparedBy  String?
  status      OficioStatus @default(DRAFT)
  attachments Json
  comments    String?    @db.Text

  oficioDate   DateTime  @db.Date
  receivedDate DateTime? @db.Date
  sentDate     DateTime? @db.Date

  createdById String
  createdBy   User   @relation("OficioCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([status])
  @@index([type])
  @@index([scope])
  @@map("oficios")
}

// ============================================
// MÓDULO DE EQUIPOS Y ASIGNACIÓN
// ============================================

enum EquipmentCategory {
  DESKTOP_PC
  LAPTOP
  PRINTER
  PHONE
  MONITOR
  UPS
  ACCESSORY
  OTHER
}

enum EquipmentStatus {
  AVAILABLE
  ASSIGNED
  IN_MAINTENANCE
  DAMAGED
  RETIRED
  LOST
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
  REPLACED
  LOST
  CANCELLED
}

enum EquipmentHistoryAction {
  CREATED
  ASSIGNED
  RETURNED
  REPLACED
  MAINTENANCE
  STATUS_CHANGED
  RETIRED
  UPDATED
}

model Employee {
  id           String   @id @default(cuid())
  employeeCode String?  @unique
  firstName    String
  lastName     String
  fullName     String
  email        String   @unique
  phone        String?
  dni          String?
  userId       String?  @unique
  departmentId String?
  positionId   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  department  Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position    JobPosition?          @relation(fields: [positionId], references: [id], onDelete: SetNull)
  assignments EquipmentAssignment[]

  @@index([departmentId])
  @@index([positionId])
  @@index([email])
  @@map("employees")
}

model Equipment {
  id            String            @id @default(cuid())
  inventoryCode String            @unique
  category      EquipmentCategory @default(OTHER)
  type          String
  brand         String
  model         String
  serialNumber  String?           @unique
  status        EquipmentStatus   @default(AVAILABLE)

  purchaseDate     DateTime? @db.Date
  purchaseOrder    String?
  supplier         String?
  warrantyDate     DateTime? @db.Date
  depreciationDate DateTime? @db.Date
  cost             Float?

  ram         String?
  processor   String?
  storage     String?
  os          String?
  ipAddress   String?
  macAddress  String?
  location    String?
  notes       String? @db.Text

  retirementReason String?   @db.Text
  retiredAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments  EquipmentAssignment[]
  maintenances EquipmentMaintenance[]
  history      EquipmentHistory[]

  @@index([status])
  @@index([category])
  @@index([type])
  @@index([inventoryCode])
  @@index([serialNumber])
  @@map("equipment")
}

model EquipmentAssignment {
  id           String           @id @default(cuid())
  equipmentId  String
  employeeId   String?
  userId       String?
  assignedById String?
  status       AssignmentStatus @default(ACTIVE)
  assignedDate DateTime         @default(now())
  returnedDate DateTime?

  departmentAtTime    String?
  positionAtTime      String?
  employeeEmailAtTime String?
  employeeNameAtTime  String?

  deliveryReason      String?
  assignmentNotes     String? @db.Text
  deliveryDocumentUrl String?
  returnDocumentUrl   String?

  returnedById    String?
  returnReason    String?
  returnNotes     String? @db.Text
  returnCondition String?

  notes      String? @db.Text
  urlNotaPdf String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  employee  Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([equipmentId])
  @@index([employeeId])
  @@index([userId])
  @@index([status])
  @@index([assignedDate])
  @@map("equipment_assignments")
}

model EquipmentHistory {
  id            String                 @id @default(cuid())
  equipmentId   String
  action        EquipmentHistoryAction
  title         String
  description   String?                @db.Text
  previousData  Json?
  newData       Json?
  performedById String?
  createdAt     DateTime               @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([action])
  @@index([createdAt])
  @@map("equipment_history")
}

// ============================================
// MÓDULO DE INVENTARIO PROMOCIONAL
// ============================================

model PromotionalItem {
  id            String @id @default(cuid())
  inventoryCode String @unique
  name          String
  description   String? @db.Text
  quantity      Int     @default(0)
  unitPrice     Float
  purchaseDate  DateTime @db.Date
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())

  movements PromotionalMovement[]

  @@map("promotional_items")
}

enum MovementType {
  EXIT
  RETURN
}

model PromotionalMovement {
  id             String       @id @default(cuid())
  itemId         String
  type           MovementType
  quantityOut    Int
  quantityReturn Int?         @default(0)
  movementDate   DateTime     @db.Date
  returnDate     DateTime?    @db.Date

  eventName     String?
  eventLocation String?
  eventDate     DateTime? @db.Date
  responsible   String?
  comments      String?   @db.Text

  createdAt DateTime        @default(now())
  item      PromotionalItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@map("promotional_movements")
}

// ============================================
// MÓDULO DE COMPRAS / ADQUISICIONES
// ============================================

model PurchaseRequest {
  id            String   @id @default(cuid())
  title         String
  description   String   @db.Text
  justification String   @db.Text
  category      String
  priority      String
  status        String   @default("PENDING")

  deliveryDate  DateTime? @db.Date
  receptionDate DateTime? @db.Date
  closingDate   DateTime? @db.Date

  attachments Json?
  comments    String? @db.Text

  requestedById String
  requestedBy   User   @relation("PurchaseRequester", fields: [requestedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestedById])
  @@index([status])
  @@map("purchase_requests")
}

// ============================================
// MÓDULO DE MANTENIMIENTO DE EQUIPOS
// ============================================

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  UPDATE
  INSPECTION
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model EquipmentMaintenance {
  id              String            @id @default(cuid())
  equipmentId     String
  type            MaintenanceType   @default(PREVENTIVE)
  status          MaintenanceStatus @default(SCHEDULED)
  description     String            @db.Text
  scheduledDate   DateTime?         @db.Date
  completedDate   DateTime?         @db.Date
  cost            Float?
  technician      String?
  notes           String?           @db.Text
  documentUrl     String?
  performedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([status])
  @@index([scheduledDate])
  @@map("equipment_maintenances")
}

// ============================================
// MÓDULO DE AUDITORÍAS ISO 19011
// ============================================

enum AuditStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AuditType {
  INTERNAL
  EXTERNAL
  COMBINED
}

model Audit {
  id              String       @id @default(cuid())
  code            String       @unique
  title           String
  description     String?      @db.Text
  type            AuditType    @default(INTERNAL)
  status          AuditStatus  @default(PLANNED)
  standard        String?
  scope           String?      @db.Text
  objectives      String?      @db.Text
  criteria        String?      @db.Text
  department      String?
  conclusions     String?      @db.Text
  recommendations String?      @db.Text
  auditeeContact  String?
  plannedDate     DateTime?    @db.Date
  startDate       DateTime?
  endDate         DateTime?

  leadAuditorId   String?
  createdById     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadAuditor User?           @relation("AuditLeadAuditor", fields: [leadAuditorId], references: [id], onDelete: SetNull)
  createdBy   User?           @relation("AuditCreator", fields: [createdById], references: [id], onDelete: SetNull)
  findings    AuditFinding[]
  checklist   AuditChecklistItem[]

  @@index([status])
  @@index([leadAuditorId])
  @@index([plannedDate])
  @@map("audits")
}

enum AuditFindingSeverity {
  STRENGTH
  CONFORMITY
  OBSERVATION
  MINOR_NC
  MAJOR_NC
}

model AuditFinding {
  id          String               @id @default(cuid())
  auditId     String
  code        String?
  description String              @db.Text
  evidence    String?             @db.Text
  severity    AuditFindingSeverity
  clause      String?
  status      String              @default("OPEN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([severity])
  @@map("audit_findings")
}

enum ChecklistResult {
  CONFORMING
  NON_CONFORMING
  OBSERVATION
  NOT_APPLICABLE
}

model AuditChecklistItem {
  id          String          @id @default(cuid())
  auditId     String
  description String?         @db.Text
  requirement String          @db.Text
  clause      String?
  sortOrder   Int             @default(0)
  completed   Boolean         @default(false)
  result      ChecklistResult?
  notes       String?         @db.Text
  evidence    String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([sortOrder])
  @@map("audit_checklist_items")
}

enum CorrectiveActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

model CorrectiveAction {
  id            String                @id @default(cuid())
  findingId     String?
  auditId       String?
  description   String                @db.Text
  responsibleId String?
  dueDate       DateTime?             @db.Date
  completedDate DateTime?
  status        CorrectiveActionStatus @default(PENDING)
  evidence      String?               @db.Text
  notes         String?               @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responsible User? @relation("CorrectiveActionResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  @@index([findingId])
  @@index([auditId])
  @@index([status])
  @@index([responsibleId])
  @@map("corrective_actions")
}
