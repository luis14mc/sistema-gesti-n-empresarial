  @@index([orderNumber])
  @@index([status])
  @@index([requestDate])
  @@index([requiredDate])
  @@index([supplierId])
  @@index([createdById])
  @@index([sequenceYear])
  @@index([organizationId, status])
  @@map("purchase_orders")
