  generatedById         String?
  generatedAt           DateTime?
  issuedById            String?
  issuedAt              DateTime?
  cancelledById         String?
  cancelledAt           DateTime?
  cancellationReason    String?             @db.Text
  closedById            String?
  closedAt              DateTime?
  templateId            String?
  templateVersion       Int?
  templateSnapshot      Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?
  organizationId        String?

  createdBy              User                    @relation("CompraOrdenCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  generatedBy            User?                   @relation("CompraOrdenGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  issuedBy               User?                   @relation("CompraOrdenIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  cancelledBy            User?                   @relation("CompraOrdenCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  closedBy               User?                   @relation("CompraOrdenClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  supplier               Proveedor?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  template               CompraOrdenTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
