// People & identity

model Department {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  employees      Employee[]
  positions      JobPosition[]
  users          User[]
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("departments")
}

model JobPosition {
  id           String     @id @default(cuid())
  name         String     @unique
  departmentId String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  employees    Employee[]
  department   Department @relation(fields: [departmentId], references: [id])
  users        User[]

  @@index([departmentId])
  @@map("job_positions")
}

model AttendancePolicy {
  id               String  @id @default(cuid())
  name             String
  officialCheckIn  String
  officialCheckOut String
  toleranceMinutes Int     @default(15)
  isActive         Boolean @default(true)

  @@map("attendance_policies")
}

model User {
  id                           String                       @id @default(cuid())
  employeeNumber               String                       @unique
  email                        String                       @unique
  password                     String
  firstName                    String
  lastName                     String
  phone                        String?
  role                         Role                         @default(USER)
  platformRole                 PlatformRole?
  isActive                     Boolean                      @default(true)
  departmentId                 String?
  positionId                   String?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  auditRecords                 AuditRecord[]                @relation("AuditUser")
  auditsCreated                Audit[]                      @relation("AuditCreator")
  auditsLed                    Audit[]                      @relation("AuditLeadAuditor")
  comprasAdjuntos              CompraAdjunto[]              @relation("CompraAdjuntoUploader")
  comprasDocumentos            CompraDocumento[]
  comprasSolicitadas           CompraSolicitud[]            @relation("CompraSolicitante")
  comprasOrdenesCreadas        CompraOrden[]                @relation("CompraOrdenCreatedBy")
  comprasOrdenesGeneradas      CompraOrden[]                @relation("CompraOrdenGeneratedBy")
  comprasOrdenesEmitidas       CompraOrden[]                @relation("CompraOrdenIssuedBy")
  comprasOrdenesAnuladas       CompraOrden[]                @relation("CompraOrdenCancelledBy")
  comprasOrdenesCerradas       CompraOrden[]                @relation("CompraOrdenClosedBy")
  comprasOrdenDocumentos       CompraOrdenDocumento[]       @relation("CompraOrdenDocumentoUploader")
  comprasOrdenHistorial        CompraOrdenHistorial[]       @relation("CompraOrdenHistorialPerformer")
  comprasOrdenTemplates        CompraOrdenTemplate[]        @relation("CompraOrdenTemplateCreator")
  comprasOrdenDocumentosLegacy CompraOrdenDocumentoLegacy[] @relation("CompraOrdenDocumentoLegacy")
  comprasOrdenHistorialLegacy  CompraOrdenHistorialLegacy[] @relation("CompraOrdenHistorialLegacy")
  correctiveActions            CorrectiveAction[]           @relation("CorrectiveActionResponsible")
  employeeProfile              Employee?
  equipmentAssigned            EquipmentAssignment[]
  oficioDocuments              OficioDocument[]             @relation("OficioDocumentUploader")
  oficioTrackingEntries        OficioTracking[]             @relation("OficioTrackingPerformer")
  oficioImportBatches          OficioImportBatch[]          @relation("OficioImportBatchPerformer")
  oficiosCreated               Oficio[]                     @relation("OficioCreator")
  oficiosImported              Oficio[]                     @relation("OficioImporter")
  oficiosUpdated               Oficio[]                     @relation("OficioUpdater")
  oficioNumberingConfigsCreated OficioNumberingConfig[]     @relation("OficioNumberingConfigCreator")
  oficioNumberingConfigsUpdated OficioNumberingConfig[]     @relation("OficioNumberingConfigUpdater")
  oficioSignersCreated         OficioSigner[]               @relation("OficioSignerCreator")
  ticketsAssigned              Ticket[]                     @relation("TicketAssignee")
  ticketsCreated               Ticket[]                     @relation("TicketCreator")
  timeEntries                  TimeEntry[]
  department                   Department?                  @relation(fields: [departmentId], references: [id])
  position                     JobPosition?                 @relation(fields: [positionId], references: [id])
  organizationMemberships      OrganizationMembership[]
  disposalsEvaluated           EquipmentDisposal[]          @relation("DisposalEvaluator")
  disposalsApproved            EquipmentDisposal[]          @relation("DisposalApprover")
  disposalDocumentsUploaded    DisposalDocument[]           @relation("DisposalDocumentUploader")
  disposalHistory              EquipmentDisposalHistory[]   @relation("DisposalHistoryPerformer")
  notifications                Notification[]
  permissionOverrides          UserPermissionOverride[]     @relation("UserPermissionOverrides")
  permissionOverridesCreated   UserPermissionOverride[]     @relation("PermissionOverrideCreator")
  roleSettingsUpdated          RoleSetting[]                @relation("RoleSettingUpdatedBy")
  @@index([departmentId])
  @@index([positionId])
  @@index([role])
  @@index([platformRole])
  @@map("users")
}

model Employee {
  id             String                @id @default(cuid())
  organizationId String
  employeeCode   String?
  firstName      String
  lastName       String
  fullName       String
  email          String
  hireDate       DateTime?             @db.Date
  phone          String?
  dni            String?
  userId         String?               @unique
  departmentId   String?
  positionId     String?
  isActive            Boolean               @default(true)
  monthlySalary       Decimal?              @db.Decimal(12, 2)
  otherDeduction      Decimal               @default(0) @db.Decimal(12, 2)
  otherDeductionNote  String?
  payrollEnabled      Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department     Department?           @relation(fields: [departmentId], references: [id])
  position       JobPosition?          @relation(fields: [positionId], references: [id])
  user           User?                 @relation(fields: [userId], references: [id])
  assignments    EquipmentAssignment[]
  purchaseOrders CompraOrden[]         @relation("CompraOrdenRequester")
  oficiosResponsible Oficio[]          @relation("OficioResponsibleEmployee")
  licenseAssignments LicenseAssignment[]
  payslips           Payslip[]

  @@unique([organizationId, email])
  @@unique([organizationId, employeeCode])
  @@index([organizationId, isActive])
  @@index([departmentId])
  @@index([positionId])
  @@map("employees")
}
