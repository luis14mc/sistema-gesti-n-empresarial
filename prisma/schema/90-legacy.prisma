enum AttendanceStatus {
  ON_TIME
  LATE
  ABSENT
  EXCUSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}
