generator client {
  provider      = "prisma-client-js"
  compilerBuild = "fast" 
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// MÓDULO DE USUARIOS Y AJUSTES
// ============================================

enum Role {
  ADMIN
  USER
  RRHH
  IT
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  users       User[]
  positions   JobPosition[]

  @@map("departments")
}

model JobPosition {
  id           String     @id @default(cuid())
  name         String     @unique
  departmentId String
  isActive     Boolean    @default(true)
  
  department   Department @relation(fields: [departmentId], references: [id])
  users        User[]

  @@map("job_positions")
}

model AttendancePolicy {
  id                  String   @id @default(cuid())
  name                String
  officialCheckIn     String   // ej: "08:00"
  officialCheckOut    String   // ej: "17:00"
  toleranceMinutes    Int      @default(15)
  isActive            Boolean  @default(true)

  @@map("attendance_policies")
}

model User {
  id             String       @id @default(cuid())
  employeeNumber String       @unique
  email          String       @unique
  firstName      String
  lastName       String
  phone          String?
  role           Role         @default(USER)
  isActive       Boolean      @default(true)
  departmentId   String?
  positionId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  department     Department?  @relation(fields: [departmentId], references: [id])
  position       JobPosition? @relation(fields: [positionId], references: [id])
  
  // Relaciones
  ticketsCreated      Ticket[]              @relation("TicketCreator")
  ticketsAssigned     Ticket[]              @relation("TicketAssignee")
  oficiosCreated      Oficio[]              @relation("OficioCreator")
  timeEntries         TimeEntry[]
  equipmentAssigned   EquipmentAssignment[]
  purchaseRequests    PurchaseRequest[]
  auditRecords        AuditRecord[]         @relation("AuditUser")

  @@map("users")
}

// ============================================
// MÓDULO DE AUDITORÍAS (TRANSVERSAL E INTERNA)
// ============================================

model AuditRecord {
  id             String    @id @default(cuid())
  title          String
  description    String    @db.Text
  justification  String?   @db.Text
  module         String    // TICKETS, OFICIOS, EQUIPOS, ASISTENCIA, MANUAL
  category       String
  priority       String    // BAJA, MEDIA, ALTA, URGENTE
  status         String
  deliveryDate   DateTime?
  receptionDate  DateTime?
  closingDate    DateTime?
  attachments    Json?     // URLs de archivos
  comments       String?   @db.Text
  
  // Para trazabilidad del sistema
  entityId       String?   // ID del registro afectado en otros módulos
  previousData   Json?
  newData        Json?
  
  userId         String?
  user           User?     @relation("AuditUser", fields: [userId], references: [id])
  
  createdAt      DateTime  @default(now())

  @@map("audit_records")
}

// ============================================
// MÓDULO DE ASISTENCIA
// ============================================

enum AttendanceStatus {
  ON_TIME
  LATE
  ABSENT
  EXCUSED
}

model TimeEntry {
  id          String           @id @default(cuid())
  userId      String
  date        DateTime         @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  latitude    Float            // Obligatorio para geolocalización
  longitude   Float            // Obligatorio para geolocalización
  status      AttendanceStatus @default(ON_TIME)
  notes       String?
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id])

  @@map("time_entries")
}

// ============================================
// MÓDULO DE TICKETS DE SOPORTE
// ============================================

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Ticket {
  id           String         @id @default(cuid())
  title        String
  description  String         @db.Text
  type         String
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  attachments  Json?
  comments     Json?          // Array de comentarios
  createdById  String
  assignedToId String?
  closedAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  createdBy    User           @relation("TicketCreator", fields: [createdById], references: [id])
  assignedTo   User?          @relation("TicketAssignee", fields: [assignedToId], references: [id])

  @@map("tickets")
}

// ============================================
// MÓDULO DE OFICIOS Y MEMOS
// ============================================

enum OficioType {
  INCOMING
  OUTGOING
  INTERNAL_MEMO
}

model Oficio {
  id            String     @id @default(cuid())
  number        String     @unique // Ej: CNI-002-2026 o DPICP-002-2026
  type          OficioType
  subject       String
  status        String     @default("DRAFT")
  attachments   Json       // Obligatorio (JPG, PDF, DOCX, etc)
  comments      String?    @db.Text
  
  oficioDate    DateTime   @db.Date
  receivedDate  DateTime?  @db.Date
  sentDate      DateTime?  @db.Date // Solo para salidas
  
  createdById   String
  createdBy     User       @relation("OficioCreator", fields: [createdById], references: [id])
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("oficios")
}

// ============================================
// MÓDULO DE EQUIPOS Y ASIGNACIÓN
// ============================================

enum EquipmentStatus {
  AVAILABLE
  ASSIGNED
  IN_MAINTENANCE
  DAMAGED
  RETIRED
}

model Equipment {
  id               String          @id @default(cuid())
  inventoryCode    String          @unique // Ej: CNI-2024L001
  type             String          // LAPTOP, DESKTOP, PRINTER, MONITOR
  brand            String
  model            String
  serialNumber     String          @unique
  status           EquipmentStatus @default(AVAILABLE)
  
  purchaseDate     DateTime        @db.Date
  warrantyDate     DateTime?       @db.Date
  depreciationDate DateTime?       @db.Date
  
  // Especificaciones de PC/Laptop
  ram              String?
  processor        String?
  storage          String?
  os               String?
  
  // Baja
  retirementReason String?         @db.Text
  retiredAt        DateTime?
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  assignments      EquipmentAssignment[]

  @@map("equipment")
}

model EquipmentAssignment {
  id               String    @id @default(cuid())
  equipmentId      String
  userId           String
  status           String    @default("ACTIVE") // ACTIVE, RETURNED
  assignedDate     DateTime  @default(now())
  returnedDate     DateTime?
  
  // Históricos
  departmentAtTime String?
  positionAtTime   String?
  
  notes            String?   @db.Text
  urlNotaPdf       String?   // Nota de asignación generada

  equipment        Equipment @relation(fields: [equipmentId], references: [id])
  user             User      @relation(fields: [userId], references: [id])

  @@map("equipment_assignments")
}

// ============================================
// MÓDULO DE INVENTARIO PROMOCIONAL
// ============================================

model PromotionalItem {
  id            String                @id @default(cuid())
  inventoryCode String                @unique // Ej: CNI-Prom-F001
  name          String
  description   String?               @db.Text
  quantity      Int                   @default(0)
  unitPrice     Float
  purchaseDate  DateTime              @db.Date
  status        String                @default("ACTIVE")
  createdAt     DateTime              @default(now())

  movements     PromotionalMovement[]

  @@map("promotional_items")
}

enum MovementType {
  EXIT
  RETURN
}

model PromotionalMovement {
  id             String          @id @default(cuid())
  itemId         String
  type           MovementType
  quantityOut    Int
  quantityReturn Int?            @default(0)
  movementDate   DateTime        @db.Date
  returnDate     DateTime?       @db.Date
  
  // Datos de la Feria/Actividad
  eventName      String?
  eventLocation  String?
  eventDate      DateTime?       @db.Date
  responsible    String?
  comments       String?         @db.Text
  
  createdAt      DateTime        @default(now())

  item           PromotionalItem @relation(fields: [itemId], references: [id])

  @@map("promotional_movements")
}

// ============================================
// MÓDULO DE COMPRAS / ADQUISICIONES
// ============================================

model PurchaseRequest {
  id             String    @id @default(cuid())
  title          String
  description    String    @db.Text
  justification  String    @db.Text
  category       String
  priority       String
  status         String    @default("PENDING")
  
  deliveryDate   DateTime? @db.Date
  receptionDate  DateTime? @db.Date
  closingDate    DateTime? @db.Date
  
  attachments    Json?
  comments       String?   @db.Text
  
  requestedById  String
  requestedBy    User      @relation(fields: [requestedById], references: [id])
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("purchase_requests")
}